# Let Git normalise line endings for text files
* text=auto

# Windows scripts keep Windows line endings
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary

# Unity WebGL build files
*.wasm binary
*.data binary
*.framework.js -text -diff
*.loader.js -text -diff
*.unityweb binary
